# Local guest preview works without any credentials.
VITE_ENVIRONMENT=development

# Optional real sign-in. Use the client's public/publishable legacy anon key.
# Leave both blank to keep guest mode. Never put a service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional live career chat. This is a server endpoint URL, never a provider key.
# POST { messages: [{ role: "user" | "assistant", content: string }] }
# Response { reply: string }. Keep model-provider credentials on that server.
VITE_CAREER_CHAT_URL=
